    {
      "id": "cmoadcb2q0000cdpzg3r9luoq",
      "key": "hero_headline",
      "value": "Your Himachal Adventure Starts Here",
      "updatedAt": "2026-04-25T12:21:22.666Z"
    },
    {
      "id": "cmoadcd8k0001cdpzhf1dyxjz",
      "key": "hero_subheadline",
      "value": "Safe rides. Local expertise. Unforgettable journeys through the heart of the Himalayas.",
      "updatedAt": "2026-04-25T12:21:22.679Z"
    },
    {
      "id": "cmoadcdjp0002cdpz9hc8gabb",
      "key": "hero_cta_text",
      "value": "Plan Your Trip",
      "updatedAt": "2026-04-25T12:21:22.686Z"
    },
    {
      "id": "cmoadcds60003cdpz8eu6g12m",
      "key": "hero_cta_call",
      "value": "Call Us Now",
      "updatedAt": "2026-04-25T12:21:22.699Z"
    },
    {
      "id": "cmoadce0l0004cdpzrkcmncx9",
      "key": "about_who_we_are",
      "value": "Himvigo is a Himachal Pradesh-based travel company built by locals who know these mountains like the back of their hand. We connect travelers with verified drivers, comfortable vehicles, and thoughtfully designed tour packages across the state's most breathtaking destinations.\n\nWe started with a simple belief: traveling through Himachal should feel easy, safe, and genuinely enjoyable—not stressful. Whether you're planning a honeymoon in Manali, a family vacation to Shimla, or an adventure trip to Spiti Valley with friends, we handle the logistics so you can focus on making memories.",
      "updatedAt": "2026-04-25T12:21:22.706Z"
    },
    {
      "id": "cmoadce910005cdpz84jj7qid",
      "key": "about_trust_us_json",
      "value": "[{\"title\":\"Local knowledge\",\"desc\":\"Our team lives and works in Himachal. We know the roads, the weather patterns, the hidden spots, and the best times to visit.\"},{\"title\":\"Verified drivers\",\"desc\":\"Every driver in our network is background-checked, experienced in mountain driving, and committed to your safety.\"},{\"title\":\"Transparent pricing\",\"desc\":\"No surprise charges. No hidden fees. The price we quote is the price you pay.\"},{\"title\":\"Real support\",\"desc\":\"Questions at midnight? Route changes? We're available around the clock to help.\"}]",
      "updatedAt": "2026-04-25T12:21:22.719Z"
    },
    {
      "id": "cmoadcehi0006cdpzspe4z6sd",
      "key": "service_packages_desc",
      "value": "Thoughtfully planned itineraries covering Himachal's most loved destinations—Manali, Shimla, Dharamshala, Kasol, Spiti Valley, and Leh Ladakh. Each package includes comfortable stays, reliable transport, and local insights that make your trip special.\n\nChoose from honeymoon packages, family tours, adventure trips, or spiritual journeys. We design routes that balance must-see spots with enough breathing room to actually enjoy them.",
      "updatedAt": "2026-04-25T12:21:22.726Z"
    },
    {
      "id": "cmoadcepz0007cdpzpkocsuqw",
      "key": "service_cab_desc",
      "value": "Reliable cab service across Himachal Pradesh with verified, experienced drivers. Whether you need an airport pickup, a one-way drop, or a multi-day rental, we match you with clean, well-maintained vehicles and drivers who know mountain roads.\n\nAvailable vehicles include hatchbacks, sedans, SUVs, and MUVs—suitable for solo travelers, couples, and small families.",
      "updatedAt": "2026-04-25T12:21:22.739Z"
    },
    {
      "id": "cmo8v4w90000104k1r04kap5z",
      "key": "site_phone",
      "value": "+91-9805514018",
      "updatedAt": "2026-04-25T12:21:22.746Z"
    },
    {
      "id": "cmo8v4w9r000404k10928z2gn",
      "key": "site_whatsapp",
      "value": "+91-9805514018",
      "updatedAt": "2026-04-25T12:21:22.759Z"
    },
    {
      "id": "cmoadceyg0008cdpz6fwkouba",
      "key": "service_tempo_desc",
      "value": "Traveling with a group? Our tempo travellers seat 9 to 26 passengers comfortably, making them ideal for college trips, family reunions, corporate outings, and friend groups exploring Himachal together.\n\nAll vehicles come with experienced drivers, ample luggage space, and the reliability you need for mountain journeys.",
      "updatedAt": "2026-04-25T12:21:22.779Z"
    },
    {
      "id": "cmoadcf6z0009cdpzd7n0xmf6",
      "key": "service_custom_desc",
      "value": "Not finding what you're looking for in our packages? Tell us what you have in mind. We'll build a custom itinerary around your dates, budget, interests, and group size—whether that's a week-long road trip through Lahaul or a quick weekend getaway to Kasol.",
      "updatedAt": "2026-04-25T12:21:22.786Z"
    },
    {
      "id": "cmoadcfg5000acdpz40p6ysau",
      "key": "why_choose_us_json",
      "value": "[{\"title\":\"Verified Drivers\",\"desc\":\"Every driver is background-checked and skilled in navigating Himachal's mountain roads safely.\",\"image\":\"/hero-1.png\",\"icon\":\"RiShieldCheckLine\"},{\"title\":\"24/7 Support\",\"desc\":\"Travel questions don't follow business hours. Reach us anytime—before, during, or after your trip.\",\"image\":\"/hero-2.png\",\"icon\":\"RiGroupLine\"},{\"title\":\"Affordable Pricing\",\"desc\":\"Competitive rates with no hidden costs. We believe quality travel shouldn't break the bank.\",\"image\":\"/hero-spiti.png\",\"icon\":\"RiTrophyLine\"},{\"title\":\"Local Travel Experts\",\"desc\":\"We're based in Himachal. We know the terrain, the seasons, and the insider tips that make trips better.\",\"image\":\"/kasol.png\",\"icon\":\"RiCompass3Line\"},{\"title\":\"Comfortable Vehicles\",\"desc\":\"Clean, well-maintained cars and tempo travellers with experienced drivers for every journey.\",\"image\":\"/manali-hero.png\",\"icon\":\"RiCarLine\"},{\"title\":\"Flexible Booking\",\"desc\":\"Change of plans? We work with you. Flexibility is part of how we operate.\",\"image\":\"/spiti-hero.png\",\"icon\":\"RiCheckboxCircleLine\"}]",
      "updatedAt": "2026-04-25T12:21:22.794Z"
    },
    {
      "id": "cmoadcfoo000bcdpzaaevs3yd",
      "key": "bottom_cta_headline",
      "value": "Ready to Explore Himachal?",
      "updatedAt": "2026-04-25T12:21:22.817Z"
    },
    {
